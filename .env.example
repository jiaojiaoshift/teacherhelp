TEACHHELPER_AI_PROVIDER=ccswitch
# Optional public root origin for reverse-proxy/domain deployments.
# TEACHHELPER_PUBLIC_ORIGIN=https://teachhelper.example.com
# Optional persistent data root. Containers set this to /data.
# TEACHHELPER_DATA_ROOT=/absolute/path/to/teachhelper-data
# Optional mobile-only override; otherwise TEACHHELPER_PUBLIC_ORIGIN is used.
# TEACHHELPER_MOBILE_UPLOAD_BASE_URL=https://teachhelper.example.com
# Optional overrides. By default teacherhelp reads CODEX_HOME/config.toml and auth.json.
# TEACHHELPER_AI_BASE_URL=https://gateway.example.com/v1
# TEACHHELPER_AI_MODEL=gpt-5.6-sol
# TEACHHELPER_AI_REASONING_EFFORT=xhigh
# TEACHHELPER_AI_API_KEY=your_api_key
# TEACHHELPER_AI_WIRE_API=responses
# Optional AI request concurrency for per-page detection and per-question OCR/classification.
# One TeachHelper service uses this request pool; values above 25 are capped.
# NEXT_PUBLIC_TEACHHELPER_AI_REQUEST_CONCURRENCY=12
# Legacy page-detection-only override. Values above 25 are capped.
# NEXT_PUBLIC_TEACHHELPER_QUESTION_BOX_CONCURRENCY=12
